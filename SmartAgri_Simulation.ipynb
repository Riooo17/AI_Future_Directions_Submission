"# Create sequences (28 days) and targets (next week average)\n",
"X = []\n",
"y = []\n",
"for plot in range(num_plots):\n",
" sub = df[df['plot']==plot].reset_index(drop=True)\n",
" for t in range(28, days-7):\n",
" hist = sub.loc[t-28:t-1, ['moisture','temp','light','ph']].values\n",
" next_week_vals = []\n",
" for d in range(t, t+7):\n",
" next_week_vals.append((sub.loc[d-7:d-1, 'moisture'].mean()*0.6 + (25 - abs(25-sub.loc[d-7:d-1,'temp'].mean()))*0.02 + sub.loc[d-7:d-1,'light'].mean()/20000)*10)\n",
" X.append(hist)\n",
" y.append(np.mean(next_week_vals))\n",
"X = np.array(X)\n",
"y = np.array(y)\n"
